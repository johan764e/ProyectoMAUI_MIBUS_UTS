<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI_MIBUS_UTS.PermisosPage"
             BackgroundColor="#F7F5FA">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="20">

            <VerticalStackLayout Spacing="5">
                <Label Text="Activa tus alarmas"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#59358C"/>

                <Label Text="Te avisamos a qué hora llega tu camión y si el chofer reporta algún problema. Es opcional: sin esto solo verás rutas y horarios."
                       FontSize="14"
                       TextColor="#777777"/>
            </VerticalStackLayout>

            <Border BackgroundColor="White"
                    Stroke="#E5DDED"
                    StrokeShape="RoundRectangle 12"
                    Padding="15">

                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Alarma de llegada"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#59358C"/>
                        <Label Text="Un aviso unos minutos antes de que llegue tu camión"
                               FontSize="13"
                               TextColor="#777777"/>
                    </VerticalStackLayout>

                    <Switch Grid.Column="1"
                            IsToggled="True"
                            OnColor="#59358C"
                            VerticalOptions="Center"/>
                </Grid>
            </Border>

            <Border BackgroundColor="White"
                    Stroke="#E5DDED"
                    StrokeShape="RoundRectangle 12"
                    Padding="15">

                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Avisos del chofer"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#59358C"/>
                        <Label Text="Si el camión sí pasará, va con retraso o no pasará"
                               FontSize="13"
                               TextColor="#777777"/>
                    </VerticalStackLayout>

                    <Switch Grid.Column="1"
                            IsToggled="True"
                            OnColor="#59358C"
                            VerticalOptions="Center"/>
                </Grid>
            </Border>

            <Button Text="Activar alarmas"
                    Clicked="OnPermitirClicked"
                    BackgroundColor="#59358C"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="50"/>

            <Button Text="Ahora no, solo horarios"
                    Clicked="OnAhoraNoClicked"
                    BackgroundColor="Transparent"
                    TextColor="#59358C"
                    FontAttributes="Bold"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>